rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isActive() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'Administrator';
    }

    function isCreditOfficer() {
      return isSignedIn() && role() == 'Credit Control Officer';
    }

    function isAccounts() {
      return isSignedIn() && role() == 'Accounts Department';
    }

    function isManagement() {
      return isSignedIn() && role() == 'Management';
    }

    function canOperate() {
      return isSignedIn() && isActive() && (isAdmin() || isCreditOfficer() || isAccounts());
    }

    // Every authenticated + active user can read operational/reporting data.
    function canRead() {
      return isSignedIn() && isActive();
    }

    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Everything below runs entirely client-side (Spark/free plan — no
    // Cloud Functions, no Admin SDK). Two spots intentionally trade a small
    // amount of strictness for that:
    //  - `usernames/{username}` is publicly readable so login can resolve a
    //    typed username to a real email BEFORE the user is authenticated.
    //  - `creditAccounts.currentOutstanding` is writable by any active
    //    operating role (not just Administrator) because payment/receipt/
    //    adjustment/import transactions update it inline, in place of the
    //    old onInvoiceWriteUpdateCreditAccount trigger.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // Account creation happens client-side (see src/services/userService.js
      // + src/firebase/secondaryAuth.js): an isolated secondary Firebase app
      // instance creates the Auth user without touching the admin's own
      // session, then the admin's primary session writes this profile doc.
      allow create: if isAdmin();
      // Admins can edit anything (including role — there is no Cloud
      // Function gate anymore). A user may update only their own lastLogin
      // timestamp on their own doc (set right after they sign themselves in).
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == uid && onlyChanged(['lastLogin']));
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if true;
      // `create`-only (no update/delete) makes this a write-once claim: a
      // duplicate username collides on the doc ID and Firestore evaluates
      // that as an `update`, which nothing here allows — that's what gives
      // userService.createUser() a race-safe uniqueness guarantee without a
      // transaction spanning Auth + Firestore.
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /customerMaster/{id} {
      allow read: if canRead();
      allow create, update: if isAdmin() || isCreditOfficer();
      allow delete: if isAdmin();
    }

    match /creditAccounts/{id} {
      allow read: if canRead();
      // Created alongside a new customer, so whoever can create customers
      // (Admin + Credit Officer) can initialize their credit account too.
      allow create: if isAdmin() || isCreditOfficer();
      allow delete: if isAdmin();
      // Editing an EXISTING account's creditLimit/creditDays is "manage
      // credit limits" — Administrator only, per spec. Any active operating
      // role may still update currentOutstanding, since that's a side effect
      // of their own payment/receipt/adjustment/import transactions, not a
      // limit change.
      allow update: if isAdmin() || (canOperate() && onlyChanged(['currentOutstanding']));
    }

    match /invoices/{id} {
      allow read: if canRead();
      allow create, update: if isAdmin() || isCreditOfficer() || isAccounts();
      allow delete: if isAdmin();
    }

    match /payments/{id} {
      allow read: if canRead();
      allow create, update: if isAdmin() || isCreditOfficer() || isAccounts();
      allow delete: if isAdmin();
    }

    match /paymentAllocations/{id} {
      allow read: if canRead();
      allow create, update: if isAdmin() || isCreditOfficer() || isAccounts();
      allow delete: if isAdmin();
    }

    match /receipts/{id} {
      allow read: if canRead();
      allow create, update: if isAdmin() || isCreditOfficer() || isAccounts();
      allow delete: if isAdmin();
    }

    match /receiptAllocations/{id} {
      allow read: if canRead();
      allow create, update: if isAdmin() || isCreditOfficer() || isAccounts();
      allow delete: if isAdmin();
    }

    match /journalLedger/{id} {
      allow read: if canRead();
      allow create, update: if isAdmin() || isCreditOfficer() || isAccounts();
      allow delete: if isAdmin();
    }

    match /adjustments/{id} {
      allow read: if canRead();
      allow create: if isAdmin() || isCreditOfficer() || isAccounts();
      allow update: if isAdmin() || isAccounts();
      allow delete: if isAdmin();
    }

    match /departments/{id} {
      allow read: if canRead();
      allow write: if isAdmin();
    }

    match /counters/{id} {
      allow read: if canRead();
      allow write: if canOperate();
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /notifications/{id} {
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /settings/{id} {
      allow read: if canRead();
      allow write: if isAdmin();
    }
  }
}
